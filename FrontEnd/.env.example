# Backend (Django): default ``python manage.py runserver`` → port 8000.
# Must match the port in NEXT_PUBLIC_API. Restart ``npm run dev`` after changing NEXT_PUBLIC_*.
NEXT_PUBLIC_API=http://127.0.0.1:8000

# Frontend URL (Next default port 3000)
NEXT_PUBLIC_FE=http://localhost:3000
NEXTAUTH_SECRET=    

# google auth key and id
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET= ...